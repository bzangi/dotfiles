macos-option-as-alt = true
# Follows macOS appearance (driven by the zsh `theme` function).
theme = light:gojo-limitless-light,dark:gojo-limitless-dark
# Per-machine override of the line above, written by `theme gojo|purple-void`.
# Absolute path on purpose: relative includes resolve next to the stow symlink
# target, i.e. inside the repo. Includes load last, so this wins.
config-file = ?~/.config/ghostty/theme.local

# option+backspace → ESC DEL (backward-kill-word in zsh/readline/Claude Code)
keybind = alt+backspace=text:\x1b\x7f

# option+n → ~ (option-as-alt=true mata o dead key de til do macOS)
keybind = alt+n=text:~

# Titlebar tinted with the theme bg; native tab bar below it.
# `tabs` (titlebar + tabs in one row) renders blank on macOS 27 with Ghostty 1.3.1:
# https://github.com/ghostty-org/ghostty/discussions/14303 — retry `tabs` after a stable release fixes it.
macos-titlebar-style = transparent

# Tab title is owned by the zsh preexec hook (Nerd Font icon per command, see
# .zshrc); Ghostty's own title hook registers later and would overwrite it.
shell-integration-features = no-title
# macOS doesn't fall back to a Nerd Font for PUA glyphs in tab titles.
window-title-font-family = JetBrainsMono Nerd Font Mono

# 🔔 in the tab title when a command (>5s) finishes in an unfocused tab.
notify-on-command-finish = unfocused

# Restore windows/tabs/splits + cwd on relaunch (needs a clean quit via cmd+q; running processes are not restored)
window-save-state = always
