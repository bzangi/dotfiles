[user]
	name = Bruno Zangirolami
	email = bruno@bullcredtech.com
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[init]
	defaultBranch = main

# Cores de decorate/diff são theme-aware: a função `theme` (zsh) escreve em
# ~/.gitconfig.theme (gitignored, no $HOME) a cada flip light/dark, pra não sujar
# este arquivo versionado. .theme vem antes de .local pra .local poder sobrepor.
# Git ignora include ausente (máquina nova, antes do 1º `theme`).
[include]
    path = ~/.gitconfig.theme
    path = ~/.gitconfig.local
